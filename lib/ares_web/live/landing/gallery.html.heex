<.page title="Gallery">
  <:subtitle>
    Some of the best moments from past editions of BugsByte.
  </:subtitle>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    <div
      :for={image_path <- @images}
      class="aspect-video bg-surface overflow-hidden"
    >
      <img
        src={image_path}
        alt=""
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </div>
  </div>
</.page>
