<.landing_section :if={@sponsors != []} title="Sponsors">
  <p class="uppercase text-lg md:text-xl lg:text-2xl leading-relaxed mb-8 sm:mb-12 md:mb-16">
    Take a look at the <span class="text-primary">sponsors</span> who made this event possible.
  </p>

  <.companies id="sponsors-listing" companies={@sponsors} />
</.landing_section>

<.landing_section :if={@partners != []} title="Partners">
  <p class="uppercase text-lg md:text-xl lg:text-2xl leading-relaxed mb-8 sm:mb-12 md:mb-16">
    Take a look at the <span class="text-primary">partners</span> who made this event possible.
  </p>

  <.companies id="partners-listing" companies={@partners} />
</.landing_section>
