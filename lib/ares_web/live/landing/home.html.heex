<.landing_section :if={@sponsors != []} title="Sponsors">
  <p class="uppercase text-lg md:text-xl lg:text-2xl leading-relaxed mb-8 md:mb-12">
    The companies that make BugsByte possible. Want yours here? Write to <a
      href="mailto:geral@bugsbyte.org"
      class="link-inline normal-case"
    >geral@bugsbyte.org</a>.
  </p>

  <.companies id="sponsors-listing" companies={@sponsors} />
</.landing_section>

<.landing_section :if={@partners != []} title="Partners">
  <p class="uppercase text-lg md:text-xl lg:text-2xl leading-relaxed mb-8 md:mb-12">
    The organisations that help us run BugsByte.
  </p>

  <.companies id="partners-listing" companies={@partners} />
</.landing_section>
