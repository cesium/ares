<div id="hero" class="relative h-svh min-h-160 overflow-hidden bg-background -mt-24">
  <.ascii_bee class="absolute inset-0" />

  <div class="@container absolute inset-x-0 bottom-0 page-px pb-10">
    <h1 class="font-resegrg uppercase text-hero text-foreground">BugsByte</h1>
  </div>
</div>

<section class="bg-secondary text-secondary-content page-px py-12 md:py-16 font-jersey10 uppercase">
  <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <ul class="flex flex-col gap-2 sm:flex-row sm:gap-12 text-5xl md:text-6xl leading-none">
      <li>13–15 Feb 2026</li>
      <li>48 hours</li>
      <li>Braga</li>
    </ul>
    <.button
      :if={@registrations_open}
      variant="neutral"
      navigate="/register"
      text="Register"
      icon="hero-arrow-right"
      icon_position="right"
      class="self-start lg:self-auto font-inter normal-case"
    />
    <.button
      :if={!@registrations_open}
      variant="neutral"
      navigate="/app/team-formation"
      text="Find a team"
      icon="hero-arrow-right"
      icon_position="right"
      class="self-start lg:self-auto font-inter normal-case"
    />
  </div>
</section>

<.landing_section title="What is it?">
  <p class="uppercase text-lg md:text-xl lg:text-2xl leading-relaxed">
    BugsByte is a 48-hour hackathon. Teams build a project non-stop, on a
    challenge set by one of our sponsors or on an idea of their own, and the
    best ones win cash prizes.
  </p>
</.landing_section>

<.gallery images={
  Enum.map(
    ~w(DSC07779 DSC07885 DSC08098 DSC08344 DSC08428 DSC08517 DSC08561),
    &"/images/gallery/#{&1}.JPG"
  )
} />

<.landing_section title="Where?">
  <p class="uppercase text-lg md:text-xl lg:text-2xl leading-relaxed">
    The fourth edition takes place at the University of Minho Sports Complex,
    in Gualtar, Braga.
  </p>

  <.venue_map class="mt-8" />
</.landing_section>

