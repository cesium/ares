<div class="max-w-5xl mx-auto page-px pt-8 pb-8 sm:pb-12 md:pb-16">
  <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-8 mt-16 mb-12 text-center sm:text-left">
    <div class="size-24 sm:size-32 shrink-0 rounded-full bg-gradient-to-bl from-primary to-darkest-pink flex items-center justify-center shadow-2xl">
      <span class="text-5xl sm:text-6xl font-bold">
        {String.first(@user.name)}
      </span>
    </div>
    <div class="min-w-0">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-vt323 mb-2 break-words">{@user.name}</h1>
      <p class="text-xl sm:text-2xl text-muted break-all">{@user.email}</p>
    </div>
  </div>

  <%= if @user.team && @user.team.leader_id == @user.id && length(@user.team.members) >= 2 do %>
    <div
      :if={@user.team.payment_status in [:none, :started]}
      class="mb-8 p-4 bg-green-900 border border-green-700 rounded-lg text-green-100 flex flex-row items-center justify-center gap-4 font-inter"
    >
      <.icon name="hero-banknotes" class="w-12 text-green-300" />
      <span class="text-sm">
        As the team leader, you may proceed to payment <b>only once your team is fully assembled</b>. Complete the payment for your team <.link
          patch={~p"/app/payment"}
          class="underline font-bold"
        >here</.link>.
        Teams that do not complete payment by the deadline will lose their spot.
      </span>
    </div>
  <% end %>

  <%= if @user.team do %>
    <div class="font-inter mb-8">
      <h2 class="text-3xl font-vt323 uppercase">Member of</h2>

      <div class="mb-6 pb-6 border-b border-line">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-4">
          <div class="mb-4 md:mb-0">
            <h3 class="text-3xl font-vt323 mb-2">{@user.team.name}</h3>
            <p class="text-lg text-foreground">{@user.team.description}</p>
          </div>
          <div :if={@user.team.payment_status == :paid}>
            <div class="font-inter text-green-400 flex flex-row items-center gap-2 text-xl">
              <.icon name="hero-check-circle" class="w-6 h-6" />
              <span class="font-bold">
                {String.capitalize(to_string(@user.team.payment_status))}
              </span>
            </div>
          </div>
        </div>

        <div class="bg-surface rounded px-4 py-2 inline-block text-xl font-vt323">
          <span class="text-muted uppercase">Team Code: </span>
          <span class="text-foreground">{@user.team.code}</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div>
          <p class="text-sm text-muted mb-1">Experience Level</p>
          <p class="font-bold text-foreground capitalize text-lg">
            {@user.team.experience_level}
          </p>
        </div>
        <div>
          <p class="text-sm text-muted mb-1">Members</p>
          <p class="font-bold text-foreground text-lg flex flex-row gap-4">
            {length(@user.team.members)}/5
            <span
              :if={length(@user.team.members) < 2}
              class="text-xs flex flex-row items-center gap-2"
            >
              <.icon name="hero-exclamation-triangle" class="w-8" />
              For your team to be valid, 2 or more members are required.
            </span>
          </p>
        </div>
      </div>

      <div>
        <h4 class="text-2xl mb-4 font-vt323 uppercase">Team Members:</h4>
        <div class="space-y-3">
          <%= for member <- @user.team.members do %>
            <div class="bg-surface rounded-lg p-4">
              <div class="flex flex-row justify-between items-center gap-4">
                <div class="min-w-0">
                  <p class="font-semibold text-foreground text-lg flex flex-row items-center gap-2">
                    {first_last_name(member.name)}
                    <.icon :if={@user.team.leader_id == member.id} name="hero-star" />
                  </p>
                  <p class="text-muted break-all">{member.email}</p>
                </div>
                <%= if member.id == @user.id do %>
                  <span class="bg-primary text-background text-xl font-bold px-3 py-1 rounded font-vt323 uppercase">
                    You!
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div
      :if={!@user.is_admin}
      class="text-center font-inter"
    >
      <div class="py-8">
        <.icon name="hero-users" class="w-16 h-16 mx-auto mb-4 text-subtle" />
        <p class="text-lg text-muted mb-6">
          To participate in the event, you need to join or create a team.
        </p>
        <.button
          variant="primary"
          navigate={~p"/app/team-formation"}
          text="Go to Team Formation"
          icon="hero-arrow-right"
        />
      </div>
    </div>
  <% end %>

  <div class="font-inter">
    <h2 class="text-3xl font-vt323 uppercase">Upload your CV</h2>
    <%= if @user.cv do %>
      <div class="flex items-center gap-4 mt-2">
        <p class="text-sm text-muted">Current: {@user.cv.file_name}</p>
        <button
          type="button"
          class="text-sm text-primary underline cursor-pointer"
          phx-click="remove-cv"
          onclick="return confirm('Remove current CV?');"
        >
          Remove
        </button>
      </div>
    <% end %>

    <.form
      for={@form}
      id="profile_info_form"
      phx-submit="save"
      phx-change="validate"
      class="font-inter mt-8"
    >
      <.live_component
        module={CVUploader}
        id="cv-uploader"
        uploaders={@uploads}
      />

      <.button
        variant="primary"
        phx-disable-with="Saving..."
        class="w-full mt-6"
        disabled={@cv_uploading || @cv_upload_error}
        text="Save"
      />

      <%= if @cv_upload_error do %>
        <p class="text-sm text-primary mt-2">
          There was a problem with the uploaded CV. Please remove and re-upload or try a different file.
        </p>
      <% end %>
    </.form>
  </div>
</div>
